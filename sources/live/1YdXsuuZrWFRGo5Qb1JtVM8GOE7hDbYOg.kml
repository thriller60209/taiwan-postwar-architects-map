        <name>火頭磚空屋</name>
        <description><![CDATA[https://www.facebook.com/photo?fbid=2641317109370986&set=gm.4020891341464121&idorvanity=1424087277811220]]></description>
        <styleUrl>#icon-1796-9C27B0-labelson</styleUrl>
        <Point>
          <coordinates>
